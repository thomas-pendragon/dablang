{
  "schema_version": 3,
  "default_ruby_version": "3.3.12",
  "bundler_version": "2.7.2",
  "premake_version": "5.0.0-beta8",
  "premake_action": "gmake",
  "platforms": {
    "linux-x86_64": {
      "os": "linux",
      "architecture": "x86_64",
      "ruby_versions": ["3.3.12", "3.4.9", "4.0.5"],
      "premake_command": "premake5",
      "build_driver": "make",
      "compiler": "g++",
      "clang_format": "clang-format",
      "ci": {
        "job": "test",
        "runner": "ubuntu-latest",
        "ruby_setup": "${{ matrix.ruby-version }}",
        "premake_command": "./premake5",
        "premake_asset": "premake-5.0.0-beta8-linux.tar.gz"
      }
    },
    "macos-x86_64": {
      "os": "macos",
      "architecture": "x86_64",
      "ruby_versions": ["3.3.12"],
      "premake_command": "premake5",
      "build_driver": "make",
      "compiler": "clang++",
      "clang_format": "clang-format",
      "ci": {
        "job": "test-macos",
        "runner": "macos-15-intel",
        "ruby_setup": "3.3.12",
        "premake_command": "./premake5",
        "premake_asset": "premake-5.0.0-beta8-macosx-x64.tar.gz",
        "clang_format": "$(brew --prefix llvm@18)/bin/clang-format"
      }
    },
    "windows-x86_64": {
      "os": "windows",
      "architecture": "x86_64",
      "ruby_versions": ["3.3.12"],
      "premake_command": "premake5",
      "build_driver": "make",
      "compiler": "g++",
      "clang_format": "clang-format",
      "ci": {
        "job": "test-windows",
        "runner": "windows-latest",
        "ruby_setup": "3.3.12",
        "premake_command": ".\\premake5.exe",
        "premake_asset": "premake-5.0.0-beta8-windows.zip"
      }
    }
  },
  "profiles": {
    "address_sanitizer": {
      "platform": "linux-x86_64",
      "compiler": "clang++-18",
      "compiler_version": "18",
      "c_compiler": "clang-18",
      "configuration": "ASan",
      "premake_option": "--address-sanitizer",
      "build_directory": "build/address-sanitizer",
      "object_directory": "build/address-sanitizer/obj/ASan",
      "binary_directory": "bin/address-sanitizer",
      "metadata_tool": "readelf",
      "instrumentation_symbol": "__asan_init",
      "compile_flags": [
        "-fsanitize=address",
        "-fsanitize-address-use-after-scope",
        "-fno-omit-frame-pointer",
        "-fno-optimize-sibling-calls"
      ],
      "link_flags": ["-fsanitize=address"],
      "leak_detection": true,
      "targets": {
        "cvm": "cvm",
        "cdisasm": "cdisasm",
        "cdumpcov": "cdumpcov",
        "cffitest": "libcffitest.so"
      },
      "ci": {
        "job": "address-sanitizer",
        "runner": "ubuntu-24.04",
        "ruby_setup": "3.3.12",
        "premake_command": "./premake5",
        "premake_asset": "premake-5.0.0-beta8-linux.tar.gz",
        "command": "bundle exec rake address_sanitizer_spec",
        "compiler_setup": "clang-18"
      }
    },
    "undefined_behavior_sanitizer": {
      "platform": "linux-x86_64",
      "compiler": "clang++-18",
      "compiler_version": "18",
      "c_compiler": "clang-18",
      "configuration": "UBSan",
      "premake_option": "--undefined-behavior-sanitizer",
      "build_directory": "build/undefined-behavior-sanitizer",
      "object_directory": "build/undefined-behavior-sanitizer/obj/UBSan",
      "binary_directory": "bin/undefined-behavior-sanitizer",
      "metadata_tool": "readelf",
      "instrumentation_symbol": "__ubsan_handle_[A-Za-z0-9_]+_abort",
      "symbolizer_tool": "/usr/bin/llvm-symbolizer-18",
      "compile_flags": [
        "-fsanitize=undefined",
        "-fno-sanitize-recover=all",
        "-fno-omit-frame-pointer",
        "-fno-optimize-sibling-calls"
      ],
      "link_flags": ["-fsanitize=undefined"],
      "targets": {
        "cvm": "cvm",
        "cdisasm": "cdisasm",
        "cdumpcov": "cdumpcov",
        "cffitest": "libcffitest.so"
      },
      "ci": {
        "job": "undefined-behavior-sanitizer",
        "runner": "ubuntu-24.04",
        "ruby_setup": "3.3.12",
        "premake_command": "./premake5",
        "premake_asset": "premake-5.0.0-beta8-linux.tar.gz",
        "command": "bundle exec rake undefined_behavior_sanitizer_spec",
        "compiler_setup": "clang-18"
      }
    }
  }
}
