## SOURCE
def choose(enabled:Boolean):String
return "enabled\n" if enabled
return "disabled\n"
end
def local_guard()
var enabled = nil
enabled = true
print("local\n") if enabled
end
def main()
print(choose(true))
print(choose(false))
local_guard()
print("if\n") if true
print("unless\n") unless false
print("skipped\n") if false
"abc".length unless true
nil if false
return unless true
print("tail\n")
end
## EXPECTED APPLICATION STDOUT
enabled
disabled
local
if
unless
tail

