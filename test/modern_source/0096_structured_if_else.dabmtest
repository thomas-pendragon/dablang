## SOURCE
def choose(flag : Boolean) : String
  if flag
    return "parameter-true\n"
  else
    return "parameter-false\n"
  end
end

def local_true() : String
  var current = true
  if current
    return "local-true\n"
  end
  return "wrong\n"
end

def local_false() : String
  var current = false
  if current
    return "wrong\n"
  else
    return "local-false\n"
  end
end

def optional(flag : Boolean)
  if flag
    print("optional\n")
  end
  if false
  else
  end
end

def main()
  print(choose(true))
  print(choose(false))
  print(local_true())
  print(local_false())
  optional(true)
  optional(false)
  if true;print("literal\n");end
end
## EXPECTED APPLICATION STDOUT
parameter-true
parameter-false
local-true
local-false
optional
literal

