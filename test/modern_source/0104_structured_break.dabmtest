## SOURCE
def loop_once(flag:Boolean)
while flag
print("outer-before\n")
while true
print("inner\n")
break
print("dead-inner\n")
end
print("after-inner\n")
break if true
print("dead-outer\n")
end
print("after-outer\n")
end
def main()
loop_once(true)
loop_once(false)
end
## EXPECTED APPLICATION STDOUT
outer-before
inner
after-inner
after-outer
after-outer

## NOTE
Explicitly noncanonical OR-052 coverage for nearest-loop break ownership, postfix break, dead tails, and fallthrough.
