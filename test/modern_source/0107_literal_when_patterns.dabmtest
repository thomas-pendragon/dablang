case subject()
when 1
print("wrong-one\n")
when 2
print("matched-two\n")
when 2
print("wrong-duplicate\n")
when "2"
print("wrong-string\n")
end
print("after-first\n")
case empty_subject()
when true
when true
print("wrong-empty-fallthrough\n")
end
print("after-empty\n")
end
