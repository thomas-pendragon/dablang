## SOURCE
def select(flag : Boolean) : String
  unless flag
    return "false-case\n"
  else
    return "true-case\n"
  end
end

def from_local() : String
  var current = nil
  current = false
  unless current
    return "local-false\n"
  else
    return "local-true\n"
  end
end

def optional(flag : Boolean)
  unless flag
    print("optional-body\n")
  end
  print("optional-fallthrough\n")
end

def empty(flag : Boolean)
  unless flag
  else
    print("empty-else\n")
  end
  print("empty-fallthrough\n")
end

def nested(outer : Boolean, inner : Boolean)
  unless outer
    if inner
      print("outer-false-inner-true\n")
    else
      print("outer-false-inner-false\n")
    end
  else
    unless inner
      print("outer-true-inner-false\n")
    else
      print("outer-true-inner-true\n")
    end
  end
end

def main()
  print(select(false))
  print(select(true))
  print(from_local())
  optional(false)
  optional(true)
  empty(false)
  empty(true)
  nested(false, true)
  nested(false, false)
  nested(true, false)
  nested(true, true)
end
## EXPECTED APPLICATION STDOUT
false-case
true-case
local-false
optional-body
optional-fallthrough
optional-fallthrough
empty-fallthrough
empty-else
empty-fallthrough
outer-false-inner-true
outer-false-inner-false
outer-true-inner-false
outer-true-inner-true

