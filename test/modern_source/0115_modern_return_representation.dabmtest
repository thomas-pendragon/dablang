end
def flag(value:Boolean):Boolean
  return value
end
def main()
  let negative:Int8 = 255
  print(signed_literal())
  print("|")
  print(signed_boundary())
  print("|")
  print(unsigned_wrap())
  print("|")
  print(narrowed())
  print("|")
  print(signed_widen())
  print("|")
  print(unsigned_widen())
  print("|")
  print(positive_widen())
  print("|")
  print(local_value())
  print("|")
  print(parameter_value(negative))
  print("|")
  print(nullable())
  print("|")
  print(text("text"))
  print("|")
  print(flag(true))
end
