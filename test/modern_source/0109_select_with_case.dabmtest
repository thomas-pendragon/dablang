## SOURCE
def label(value : Int32) : String
  case value
  when 1
    return "one\n"
  when 2, 3
    return "few\n"
  else
    return "many\n"
  end
end

def main()
  print(label(3))
end
## EXPECTED APPLICATION STDOUT
few

