## SOURCE
def first_value():Int8
  print("first-call\n")
  return 255
end
def second_value():Uint8
  print("second-call\n")
  return 256
end
def third_value():Boolean
  print("third-call\n")
  return true
end
def wrap(value:String):String
  print("wrap-call\n")
  return "<#{value}>"
end
def parameter(value:Int16):String
  return "#{value}"
end
def main()
  print("[#{first_value()}|#{wrap("middle #{second_value()} #{ "deep #{third_value()}" }")}|end]\n")
  let fixed = 42
  var changing = false
  print("#{nil}|#{true}|#{changing}|#{fixed}\n")
  changing = 7
  print("#{changing}|#{parameter(32767)}|#{"abc".length}|#{"abcd".length()}\n")
  let identity = "identity"
  print("#{identity}")
end
## EXPECTED APPLICATION STDOUT
first-call
second-call
third-call
wrap-call
[-1|<middle 0 deep true>|end]
nil|true|false|42
7|32767|3|4
identity
## NOTE
Implicit EX-036 conversion in bounded recursive interpolation; immediate once-only left-to-right conversion, normalized returns, literal/member/local/parameter provenance, and lone String identity.
