## SOURCE
def zero_iterations()
  while false
    print("never\n")
  end
  print("zero-fallthrough\n")
end

def select(flag : Boolean) : String
  while flag
    return "selected\n"
  end
  return "not-selected\n"
end

def from_local() : String
  var running = nil
  running = true
  while running
    return "local-selected\n"
  end
  return "local-fallthrough\n"
end

def nested(outer : Boolean, inner : Boolean) : String
  while outer
    while inner
      return "nested-both\n"
    end
    return "outer-only\n"
  end
  return "outer-false\n"
end

def empty(flag : Boolean)
  while flag
  end
  print("empty-fallthrough\n")
end

def guarded(flag : Boolean)
  while flag
    print("guarded-selected\n") if true
    return
  end
  print("guarded-fallthrough\n")
end

def main()
  zero_iterations()
  print(select(true))
  print(select(false))
  print(from_local())
  print(nested(true, true))
  print(nested(true, false))
  print(nested(false, true))
  empty(false)
  guarded(true)
  guarded(false)
end
## EXPECTED APPLICATION STDOUT
zero-fallthrough
selected
not-selected
local-selected
nested-both
outer-only
outer-false
empty-fallthrough
guarded-selected
guarded-fallthrough

