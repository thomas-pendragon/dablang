## SOURCE
def subject():Int32
  print("subject\n")
  return 9
end
def main
  case subject()
  when 1
    print("wrong-unmatched\n")
  end
  print("after-unmatched\n")
  case 2
  when 1
    print("wrong-first\n")
  when 2
    print("matched\n")
  end
  print("after-matched\n")
  case 3
  when 3
  when 3
    print("wrong-empty-fallthrough\n")
  end
  print("after-empty\n")
end
## EXPECTED APPLICATION STDOUT
subject
after-unmatched
matched
after-matched
after-empty

