## SOURCE
def first():Int8
  print("first\n")
  return 255
end
def second():Uint8
  print("second\n")
  return 256
end
def show(left:String, right:String)
  print(left)
  print("|")
  print(right)
  print("\n")
end
def converted(value:Int16):String
  return value to String
end
def to():String
  return "to"
end
def to?():String
  return "to?"
end
def main()
  show(first() to String, second() to String)
  let fixed = 42 to String
  let typed:String = nil to String
  var changing = false to String
  var annotated:String = 0 to String
  changing = true to String
  annotated = "#{fixed}!" to String
  show(fixed to String, typed to String)
  show(changing to String, annotated to String)
  print("abc".length to String)
  print("|")
  print("abc".length() to String)
  print("|")
  print(converted(32767))
  print("\n")
  print(nil to String, "|", true to String, "|", false to String, "\n")
  show(to() to String, to?() to String)
end
## EXPECTED APPLICATION STDOUT
first
second
-1|0
42|nil
true|42!
3|3|32767
nil|true|false
to|to?

