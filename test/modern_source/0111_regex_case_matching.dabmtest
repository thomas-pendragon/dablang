## SOURCE
def subject():String
  print("subject\n")
  return "prefix-Καλημέρα-suffix"
end
def main
  case subject()
  when /^Καλημέρα/
    print("wrong-anchor\n")
  when /\p{sc=Greek}+/
    print("matched-unicode\n")
  when /[/
    print("wrong-later\n")
  else
    print("wrong-else\n")
  end
  print("after\n")
  case "anything"
  when //
    print("matched-empty\n")
  else
    print("wrong-empty-else\n")
  end
end
## EXPECTED APPLICATION STDOUT
subject
matched-unicode
after
matched-empty

