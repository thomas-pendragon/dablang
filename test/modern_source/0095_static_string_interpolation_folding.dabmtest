## SOURCE
def sink(value : String)
  print(value)
end

def build() : String
  let fixed = "A"
  var latest = "old"
  latest = "B"
  latest = "#{fixed}#{latest}"
  let chained = "<#{latest}>"
  sink("call=#{chained}\n")
  print("repeat=#{fixed}#{fixed}\n")
  return "return=#{chained}:#{latest}\n"
  print("dead=#{chained}\n")
end

def main()
  print(build())
end
