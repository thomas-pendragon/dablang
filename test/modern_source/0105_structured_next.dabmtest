## SOURCE
def nested()
var outer = true
var inner = true
while outer
print("outer\n")
outer = false
while inner
print("inner\n")
inner = false
next
print("dead-inner\n")
break
end
print("after-inner\n")
next
return
break
end
print("after-outer\n")
end
def recursive(flag:Boolean)
var running = true
while running
running = false
if flag
unless false
next
print("dead-recursive\n")
end
end
print("recursive-fallthrough\n")
end
print("after-recursive\n")
end
def postfix(flag:Boolean)
var running = true
while running
running = false
next if flag
print("postfix-fallthrough\n")
next unless flag
print("dead-postfix\n")
end
print("after-postfix\n")
end
def return_before_next()
while true
print("return-before-next\n")
return
next
end
end
def break_before_next()
while true
print("break-before-next\n")
break
next
end
print("after-break\n")
end
def main()
nested()
recursive(true)
recursive(false)
postfix(true)
postfix(false)
return_before_next()
break_before_next()
end
## EXPECTED APPLICATION STDOUT
outer
inner
after-inner
after-outer
after-recursive
recursive-fallthrough
after-recursive
after-postfix
postfix-fallthrough
after-postfix
return-before-next
break-before-next
after-break

