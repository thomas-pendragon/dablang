## SOURCE
def select(first : Boolean, second : Boolean, third : Boolean) : String
  if first
    return "first\n"
  elsif second
    return "second\n"
  elsif third
    return "third\n"
  else
    return "fallback\n"
  end
end

def from_local() : String
  var current = nil
  current = true
  if false
    return "wrong\n"
  elsif current
    return "local-true\n"
  else
    return "local-false\n"
  end
end

def optional(first : Boolean, second : Boolean)
  if first
  elsif second
    print("optional-second\n")
  end
  print("optional-fallthrough\n")
end

def nested(outer : Boolean, inner : Boolean)
  if outer
    if false
    elsif inner
      print("nested-inner\n")
    else
      print("nested-fallback\n")
    end
  elsif inner
    print("outer-elsif\n")
  else
    print("outer-fallback\n")
  end
end

def main()
  print(select(true, false, false))
  print(select(false, true, false))
  print(select(false, false, true))
  print(select(false, false, false))
  print(from_local())
  optional(true, false)
  optional(false, true)
  nested(true, true)
  nested(true, false)
  nested(false, true)
  nested(false, false)
end
## EXPECTED APPLICATION STDOUT
first
second
third
fallback
local-true
optional-fallthrough
optional-second
optional-fallthrough
nested-inner
nested-fallback
outer-elsif
outer-fallback

