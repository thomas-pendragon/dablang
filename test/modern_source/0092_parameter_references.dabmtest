## SOURCE
def echo(value:String):String
  return value
end
def emit(value:String)
  print(value)
  puts(value)
end
def relay(prefix:String,value:String):String
  emit(value)
  emit(echo(value))
  print(prefix)
  print(prefix)
  print("#{prefix}:#{value}\n")
  return value
end
def main()
  print(relay("P","V"))
end
